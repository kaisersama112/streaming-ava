# streaming-ava 环境变量模板（不含真实值，可提交）
# 用法：复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会入库。
# 说明：程序当前通过 os.getenv 读取环境变量，若使用 .env 文件，请在启动前
#       由你的 shell / 进程管理器（如 export、dotenv、docker --env-file）加载。

# ---------- LLM ----------
# OpenAI 兼容接口密钥（DashScope qwen-plus 等）；覆盖 openai_config.api_key
STREAMING_AVA_OPENAI_API_KEY=
# 智谱 BigModel 密钥；覆盖 bigmodel_config.api_key
STREAMING_AVA_BIGMODEL_API_KEY=

# ---------- TTS ----------
# TTS provider: cosyvoice / step_fun / dou_bao
STREAMING_AVA_TTS_PROVIDER=
# CosyVoice（DashScope）密钥；覆盖 voice_config.cosyvoice.api_key
STREAMING_AVA_TTS_API_KEY=
# StepFun 密钥；覆盖 voice_config.step_fun.api_key
STREAMING_AVA_STEPFUN_API_KEY=
# 豆包 TTS 的 X-Api-Key；覆盖 voice_config.dou_bao.x_api_key
STREAMING_AVA_DOUBAO_X_API_KEY=
# 豆包 TTS 资源 ID（可选，yaml 已有默认值）
STREAMING_AVA_DOUBAO_X_API_RESOURCE_ID=

# ---------- ASR ----------
# ASR provider: qwen3_asr / dou_bao
STREAMING_AVA_ASR_PROVIDER=
# Qwen3 ASR（DashScope）密钥；覆盖 asr_config.qwen3_asr.api_key
STREAMING_AVA_QWEN_ASR_API_KEY=
# 豆包 ASR 的 X-Api-Key；覆盖 asr_config.dou_bao.x_api_key
STREAMING_AVA_DOUBAO_ASR_X_API_KEY=
# 豆包 ASR 资源 ID（可选，yaml 已有默认值）
STREAMING_AVA_DOUBAO_ASR_X_API_RESOURCE_ID=
# 豆包 ASR Request ID（可选）
STREAMING_AVA_DOUBAO_ASR_X_API_REQUEST_ID=

# Legacy 兼容项（仅旧扁平配置使用，通常无需设置）
STREAMING_AVA_ASR_API_KEY=
